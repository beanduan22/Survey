 \"execution_count\": 9,\nL161:    \"id\": \"0464461d-c80a-455b-9112-4a1faba22b6c\",\nL162:    \"metadata\": {},\nL163:    \"outputs\": [],\nL164:    \"source\": [\nL165:     \"# Step through everything hierarchically \\n\",\nL166:     \"for prompt in prompts:\\n\",\nL167:     \"    tableLines.append(f\\\"${prompt}$ \\\\\\\\\\\\\\\\\\\")\\n\",\nL168:     \"    for (x,y) in resultsHeaders:\\n\",\nL169:     \"        line = f\\\"{y} & \\\"\\n\",\nL170:     \"        totalList = []\\n\",\nL171:     \"        for spec in specs:\\n\",\nL172:     \"            v = values[(args.model, float(args.tau), prompt, spec)]\\n\",\nL173:     \"            count = v[x + \\\"Count\\\"] # To percentage\\n\",\nL174:     \"            correct = v[x]\\n\",\nL175:     \"            \\n\",\nL176:     \"            # List to calc stats\\n\",\nL177:     \"            sList = [100]*correct + [0]*(count - correct)\\n\",\nL178:     \"            avg = 0\\n\",\nL179:     \"            err = 0\\n\",\nL180:     \"            if len(sList) > 0:\\n\",\nL181:     \"                avg = int(np.average(sList))\\n\",\nL182:     \"                err = int(errMetric(sList))\\n\",\nL183:     \"            # Append to total\\n\",\nL184:     \"            totalList += sList\\n\",\nL185:     \"            \\n\",\nL186:     \"            line += f\\\"${avg} \\\\pm {err}$ & \\\"\\n\",\nL187:     \"        \\n\",\nL188:     \"        # Calculate row totals\\n\",\nL189:     \"        tAvg = int(np.average(totalList))\\n\",\nL190:     \"        tErr = int(errMetric(totalList))\\n\",\nL191:     \"        line += f\\\"${tAvg} \\\\pm {tErr}$ \\\\\\\\\\\\\\\\\\\"\\n\",\nL192:     \"        tableLines.append(line)\"\nL193:    ]\nL194:   },\nL195:   {\nL196:    \"cell_type\": \"code\",\nL197:    \"execution_count\": 10,\nL198:    \"id\": \"923f4c54-2bb5-4e49-8d65-a3ff0a5ee0f3\",\nL199:    \"metadata\": {\nL200:     \"scrolled\": true,\nL201:     \"tags\": []\nL202:    },\nL203:    \"outputs\": [\nL204:     {\nL205:   